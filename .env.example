# Copy this file to .env and replace the placeholder locally.
# Never commit the real .env file.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional Stage 1 settings:
# DEEPSEEK_MODEL=deepseek-v4-pro
# STAGE1_THINKING=enabled
# STAGE1_REASONING_EFFORT=high

# Windows-to-WSL MuseCoco bridge. An installed command may still be supplied as
# MUSECOCO_QUEUE_COMMAND, but explicit interpreter/script paths avoid PATH drift.
MUSECOCO_QUEUE_PYTHON=/home/<user>/miniforge3/envs/MuseCoco/bin/python
MUSECOCO_QUEUE_SCRIPT=/home/<user>/musecoco_tools/musecoco_task_queue.py

# Native Windows MIDI-GPT deployment. Keep the interpreter explicit so Stage 2
# does not depend on the currently activated Conda environment.
# LEGASYNTH_MIDIGPT_PYTHON=D:\path\to\stage2\.conda_midigpt\python.exe
LEGASYNTH_MIDIGPT_MODEL=yellow
# HF_HOME=D:\path\to\huggingface-cache

# Stage 1 postprocessing: soft attempts planned tonic/mode but preserves MIDI
# when detection is uncertain; strict fails; loose skips detection entirely.
LEGASYNTH_TONALITY_POLICY=soft

# The following variables are set inside WSL, normally in ~/.profile.
# MUSECOCO_RUNTIME_ROOT=/home/<user>/.local/share/legasynth/musecoco-runtime
# MUSECOCO_OUTPUT_ROOT=/home/<user>/.local/share/legasynth/musecoco-outputs
# MUSECOCO_TOOLS_ROOT=/home/<user>/.local/share/legasynth
# MUSECOCO_CONDA_PREFIX=/home/<user>/miniforge3/envs/MuseCoco
# MUSECOCO_PYTHON=/home/<user>/miniforge3/envs/MuseCoco/bin/python
