{
  "$defs": {
    "FormBlueprintSection": {
      "additionalProperties": false,
      "properties": {
        "base_symbol": {
          "pattern": "^[A-H]$",
          "title": "Base Symbol",
          "type": "string"
        },
        "narrative_function": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Narrative Function",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/FormRelation"
        },
        "section_id": {
          "pattern": "^S[1-9][0-9]?$",
          "title": "Section Id",
          "type": "string"
        },
        "source_section_id": {
          "anyOf": [
            {
              "pattern": "^S[1-9][0-9]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Section Id"
        },
        "variant_index": {
          "maximum": 3,
          "minimum": 0,
          "title": "Variant Index",
          "type": "integer"
        }
      },
      "required": [
        "section_id",
        "base_symbol",
        "variant_index",
        "relation",
        "narrative_function"
      ],
      "title": "FormBlueprintSection",
      "type": "object"
    },
    "FormRelation": {
      "enum": [
        "introduce",
        "reprise",
        "variation",
        "development"
      ],
      "title": "FormRelation",
      "type": "string"
    },
    "StoryPlanConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_modes": {
          "items": {
            "enum": [
              "major",
              "minor"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Allowed Modes",
          "type": "array"
        },
        "allowed_time_signatures": {
          "items": {
            "enum": [
              "1/4",
              "2/4",
              "3/4",
              "4/4",
              "3/8",
              "6/8"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Allowed Time Signatures",
          "type": "array"
        },
        "allowed_tonics": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "C",
                  "C#",
                  "D",
                  "Eb",
                  "E",
                  "F",
                  "F#",
                  "G",
                  "Ab",
                  "A",
                  "Bb",
                  "B"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tonics"
        },
        "auto_form_sections_max": {
          "default": 6,
          "maximum": 16,
          "minimum": 1,
          "title": "Auto Form Sections Max",
          "type": "integer"
        },
        "auto_form_sections_min": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Auto Form Sections Min",
          "type": "integer"
        },
        "default_extension_bars": {
          "default": 8,
          "maximum": 63,
          "minimum": 0,
          "title": "Default Extension Bars",
          "type": "integer"
        },
        "form_blueprint": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FormBlueprintSection"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Form Blueprint"
        },
        "max_theme_families": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Theme Families",
          "type": "integer"
        },
        "max_variants_per_family": {
          "default": 2,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Variants Per Family",
          "type": "integer"
        },
        "musecoco_generation_bars": {
          "default": 12,
          "maximum": 16,
          "minimum": 1,
          "title": "Musecoco Generation Bars",
          "type": "integer"
        },
        "musecoco_output_bars": {
          "default": 8,
          "maximum": 16,
          "minimum": 1,
          "title": "Musecoco Output Bars",
          "type": "integer"
        },
        "target_form_sections": {
          "anyOf": [
            {
              "maximum": 16,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Form Sections"
        },
        "tempo_bpm_max": {
          "default": 130.0,
          "maximum": 240.0,
          "minimum": 30.0,
          "title": "Tempo Bpm Max",
          "type": "number"
        },
        "tempo_bpm_min": {
          "default": 70.0,
          "maximum": 240.0,
          "minimum": 30.0,
          "title": "Tempo Bpm Min",
          "type": "number"
        },
        "total_bars": {
          "default": 64,
          "maximum": 256,
          "minimum": 4,
          "title": "Total Bars",
          "type": "integer"
        }
      },
      "title": "StoryPlanConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "$ref": "#/$defs/StoryPlanConstraints"
    },
    "language": {
      "default": "zh-CN",
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "title": "Language",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2-draft",
      "default": "0.2-draft",
      "title": "Schema Version",
      "type": "string"
    },
    "story_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Story Id",
      "type": "string"
    },
    "story_text": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Story Text",
      "type": "string"
    },
    "test_mode": {
      "default": false,
      "title": "Test Mode",
      "type": "boolean"
    }
  },
  "required": [
    "story_id",
    "story_text"
  ],
  "title": "StoryPlanRequest",
  "type": "object"
}
