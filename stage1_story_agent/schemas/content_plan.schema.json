{
  "$defs": {
    "BarRange": {
      "additionalProperties": false,
      "properties": {
        "bar_end": {
          "maximum": 256,
          "minimum": 1,
          "title": "Bar End",
          "type": "integer"
        },
        "bar_start": {
          "maximum": 256,
          "minimum": 1,
          "title": "Bar Start",
          "type": "integer"
        }
      },
      "required": [
        "bar_start",
        "bar_end"
      ],
      "title": "BarRange",
      "type": "object"
    },
    "CompiledFormSection": {
      "additionalProperties": false,
      "properties": {
        "bar_count": {
          "maximum": 64,
          "minimum": 1,
          "title": "Bar Count",
          "type": "integer"
        },
        "bar_end": {
          "maximum": 256,
          "minimum": 1,
          "title": "Bar End",
          "type": "integer"
        },
        "bar_start": {
          "maximum": 256,
          "minimum": 1,
          "title": "Bar Start",
          "type": "integer"
        },
        "form_label": {
          "pattern": "^[A-H]'{0,3}$",
          "title": "Form Label",
          "type": "string"
        },
        "material_source": {
          "$ref": "#/$defs/MaterialSource"
        },
        "musical_intent": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Musical Intent",
          "type": "string"
        },
        "narrative_segment_ids": {
          "items": {
            "pattern": "^N[1-9][0-9]?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Narrative Segment Ids",
          "type": "array"
        },
        "relation": {
          "$ref": "#/$defs/FormRelation"
        },
        "section_id": {
          "pattern": "^S[1-9][0-9]?$",
          "title": "Section Id",
          "type": "string"
        },
        "source_section_id": {
          "anyOf": [
            {
              "pattern": "^S[1-9][0-9]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Section Id"
        },
        "theme_family_id": {
          "pattern": "^theme-[A-H]$",
          "title": "Theme Family Id",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "form_label",
        "theme_family_id",
        "relation",
        "material_source",
        "bar_start",
        "bar_end",
        "bar_count",
        "narrative_segment_ids",
        "musical_intent"
      ],
      "title": "CompiledFormSection",
      "type": "object"
    },
    "DrumPatternInstruction": {
      "additionalProperties": false,
      "properties": {
        "closed_hihat_beats": {
          "items": {
            "type": "number"
          },
          "maxItems": 64,
          "title": "Closed Hihat Beats",
          "type": "array"
        },
        "kick_beats": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "Kick Beats",
          "type": "array"
        },
        "pattern": {
          "enum": [
            "single_pulse_per_bar",
            "pulse_each_beat"
          ],
          "title": "Pattern",
          "type": "string"
        },
        "snare_beats": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "Snare Beats",
          "type": "array"
        },
        "time_signature": {
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4",
            "3/8",
            "6/8"
          ],
          "title": "Time Signature",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "time_signature"
      ],
      "title": "DrumPatternInstruction",
      "type": "object"
    },
    "EmotionalArcPoint": {
      "additionalProperties": false,
      "properties": {
        "emotion": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Emotion",
          "type": "string"
        },
        "position": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Position",
          "type": "number"
        },
        "tension": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tension",
          "type": "number"
        },
        "valence": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Valence",
          "type": "number"
        }
      },
      "required": [
        "position",
        "emotion",
        "valence",
        "tension"
      ],
      "title": "EmotionalArcPoint",
      "type": "object"
    },
    "FormPlan": {
      "additionalProperties": false,
      "properties": {
        "form_string": {
          "minLength": 1,
          "title": "Form String",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/CompiledFormSection"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "form_string",
        "sections"
      ],
      "title": "FormPlan",
      "type": "object"
    },
    "FormRelation": {
      "enum": [
        "introduce",
        "reprise",
        "variation",
        "development"
      ],
      "title": "FormRelation",
      "type": "string"
    },
    "GlobalPlan": {
      "additionalProperties": false,
      "properties": {
        "global_tonality": {
          "$ref": "#/$defs/GlobalTonality"
        },
        "tempo_bpm": {
          "maximum": 240.0,
          "minimum": 30.0,
          "title": "Tempo Bpm",
          "type": "number"
        },
        "time_signature": {
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4",
            "3/8",
            "6/8"
          ],
          "title": "Time Signature",
          "type": "string"
        },
        "total_bars": {
          "maximum": 256,
          "minimum": 4,
          "title": "Total Bars",
          "type": "integer"
        }
      },
      "required": [
        "total_bars",
        "tempo_bpm",
        "time_signature",
        "global_tonality"
      ],
      "title": "GlobalPlan",
      "type": "object"
    },
    "GlobalTonality": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "major",
            "minor"
          ],
          "title": "Mode",
          "type": "string"
        },
        "rationale": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "tonic": {
          "enum": [
            "C",
            "C#",
            "D",
            "Eb",
            "E",
            "F",
            "F#",
            "G",
            "Ab",
            "A",
            "Bb",
            "B"
          ],
          "title": "Tonic",
          "type": "string"
        }
      },
      "required": [
        "tonic",
        "mode",
        "rationale"
      ],
      "title": "GlobalTonality",
      "type": "object"
    },
    "LLMStoryAnalysis": {
      "additionalProperties": false,
      "properties": {
        "emotional_arc": {
          "items": {
            "$ref": "#/$defs/EmotionalArcPoint"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Emotional Arc",
          "type": "array"
        },
        "narrative_segments": {
          "items": {
            "$ref": "#/$defs/NarrativeSegment"
          },
          "maxItems": 99,
          "minItems": 1,
          "title": "Narrative Segments",
          "type": "array"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "emotional_arc",
        "narrative_segments"
      ],
      "title": "LLMStoryAnalysis",
      "type": "object"
    },
    "MaterialSource": {
      "enum": [
        "musecoco_seed",
        "reuse_theme",
        "midigpt_variation",
        "midigpt_development"
      ],
      "title": "MaterialSource",
      "type": "string"
    },
