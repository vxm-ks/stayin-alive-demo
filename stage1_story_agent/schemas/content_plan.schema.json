        "segment_id",
        "summary",
        "narrative_role",
        "emotion",
        "valence",
        "tension"
      ],
      "title": "NarrativeSegment",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "content_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Content Attempts",
          "type": "integer"
        },
        "generated_at": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Generated At",
