        "form_label",
        "theme_family_id",
        "relation",
        "material_source",
        "bar_start",
        "bar_end",
        "input_motif_bars",
        "target_section_bars",
        "extension_bars",
        "extension_method",
        "tempo_bpm",
        "source_tension",
        "tension_level",
        "drum_pattern",
        "midigpt_access"
