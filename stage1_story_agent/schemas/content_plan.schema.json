        "I1s2": {
          "items": {
            "enum": [
              "piano",
              "keyboard",
              "percussion",
              "organ",
              "guitar",
              "bass",
              "violin",
              "viola",
              "cello",
              "harp",
              "strings",
              "voice",
              "trumpet",
              "trombone",
              "tuba",
              "horn",
              "brass",
              "sax",
