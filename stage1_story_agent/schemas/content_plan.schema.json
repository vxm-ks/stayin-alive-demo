        },
        "model": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "network_attempts": {
          "minimum": 1,
          "title": "Network Attempts",
          "type": "integer"
        },
        "prompt_version": {
          "const": "stage1-form-v8",
          "default": "stage1-form-v8",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "request_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "run_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "story_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Story Sha256",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "request_id",
        "run_id",
        "story_sha256",
        "request_sha256",
        "generated_at",
        "content_attempts",
        "network_attempts"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Stage2Handoff": {
      "additionalProperties": false,
      "properties": {
        "bar_numbering": {
          "const": "one_based_closed",
          "default": "one_based_closed",
          "title": "Bar Numbering",
          "type": "string"
        },
        "drum_track_scope": {
          "const": "instructions_only",
